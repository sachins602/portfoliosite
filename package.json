{
	"name": "portfoliosite",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun run next build",
		"check": "bun run biome check .",
		"check:unsafe": "bun run biome check --write --unsafe .",
		"check:write": "bun run biome check --write .",
		"db:generate": "bun run drizzle-kit generate",
		"db:migrate": "bun run drizzle-kit migrate",
		"db:push": "bun run drizzle-kit push",
		"db:studio": "bun run drizzle-kit studio",
		"dev": "bun run next dev --turbo",
		"preview": "bun run next build && bun run next start",
		"start": "bun run next start",
		"typecheck": "bun run tsc --noEmit"
	},
	"dependencies": {
		"@libsql/client": "^0.17.0",
		"@t3-oss/env-nextjs": "^0.13.10",
		"@tanstack/react-query": "^5.69.0",
		"@trpc/client": "^11.0.0",
		"@trpc/react-query": "^11.0.0",
		"@trpc/server": "^11.0.0",
		"@vercel/og": "^0.8.6",
		"animejs": "^4.2.2",
		"drizzle-orm": "^0.45.1",
		"lucide-react": "^0.562.0",
		"next": "^16.1.1",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"resend": "^6.7.0",
		"server-only": "^0.0.1",
		"superjson": "^2.2.1",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.5",
		"@tailwindcss/postcss": "^4.0.15",
		"@types/node": "^25.0.5",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"drizzle-kit": "^0.31.8",
		"postcss": "^8.5.3",
		"tailwindcss": "^4.0.15",
		"typescript": "^5.8.2"
	},
	"ct3aMetadata": {
		"initVersion": "7.40.0"
	}
}
